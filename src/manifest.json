{
  "manifestVersion": 5,
  "id": "com.lionevi.logoforge",
  "name": "Logo Forge",
  "version": "0.1.0",
  "main": "panel-react.html",
  "host": [
    {
      "app": "ILST",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "logoForgePanel",
      "label": {
        "default": "Logo Forge"
      },
      "minimumSize": {
        "width": 320,
        "height": 480
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 720
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"],
          "species": ["chrome"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [1, 2],
          "theme": ["dark", "darkest"],
          "species": ["chrome"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": false
  },
  "featureFlags": {
    "enableSWCSupport": true
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["light", "dark"],
      "species": ["pluginList"]
    }
  ]
}
