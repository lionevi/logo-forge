{
  "name": "logo-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plugin Adobe Illustrator (UXP) d'export automatisé de packs de logo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lionevi/logo-forge.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/generate-icons.ts && node scripts/check-cep-css.mjs && node scripts/check-jsx-es3.mjs && node scripts/check-panel-boot.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "npm run build && tsx scripts/package-ccx.ts",
    "verify": "npm run lint && npm run typecheck && npm run check:jsx && npm run test && npm run build",
    "icons": "node scripts/generate-icons.ts",
    "deploy:mac": "bash scripts/deploy-mac.sh",
    "deploy:mac:user": "LF_USER_SCOPE=1 bash scripts/deploy-mac.sh",
    "deploy:win": "npm run build && node -e \"const{cpSync,mkdirSync}=require('node:fs');const d=process.env.APPDATA+'\\\\\\\\Adobe\\\\\\\\CEP\\\\\\\\extensions\\\\\\\\com.lionevi.logoforge';mkdirSync(d,{recursive:true});cpSync('dist',d,{recursive:true});console.log('copié vers '+d)\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "check:jsx": "node scripts/check-jsx-es3.mjs",
    "check:css": "node scripts/check-cep-css.mjs",
    "fix:css": "node scripts/check-cep-css.mjs --fix",
    "install:mac": "bash scripts/install-mac.sh"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "acorn": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
